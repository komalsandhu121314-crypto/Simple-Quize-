<?php
$questions = [
    0 => 2,
    1 => 1,
    2 => 0,
    3 => 1,
    4 => 1,
    5 => 1,
    6 => 1,
    7 => 2,
    8 => 2,
    9 => 1
];

if ($_SERVER["REQUEST_METHOD"] !== "POST" ||
    !isset($_POST["answers"]) ||
    !is_array($_POST["answers"]) ||
    count($_POST["answers"]) !== 10) {
    die("Please answer all questions. <a href='index.php'>Go Back</a>");
}

$score = 0;

foreach ($questions as $i => $correctAnswer) {
    if (
        isset($_POST["answers"][$i]) &&
        (string)$_POST["answers"][$i] === (string)$correctAnswer
    ) {
        $score++;
    }
}

$percentage = ($score / 10) * 100;

if ($percentage >= 80) {
    $remarks = "Excellent Performance!";
} elseif ($percentage >= 60) {
    $remarks = "Good Performance!";
} elseif ($percentage >= 40) {
    $remarks = "Average Performance!";
} else {
    $remarks = "Needs Improvement!";
}
?>
